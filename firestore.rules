rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn()
                         && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
                         && request.auth.uid == userId;
    }

    match /live_duel_queue/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.questionCount
                       in [10, 20, 30];

      allow delete: if signedIn()
                    && request.auth.uid == userId;

      allow update: if signedIn()
                    && (
                      request.auth.uid == userId
                      ||
                      (
                        resource.data.status == 'waiting'
                        && request.resource.data.status == 'matched'
                        && request.resource.data.uid ==
                           resource.data.uid
                        && request.resource.data.rating ==
                           resource.data.rating
                        && request.resource.data.ratingBucket ==
                           resource.data.ratingBucket
                        && request.resource.data.questionCount ==
                           resource.data.questionCount
                        && request.resource.data.matchId is string
                        && request.resource.data.claimedBy ==
                           request.auth.uid
                      )
                    );
    }

    match /live_duel_matches/{matchId} {
      allow create: if signedIn()
                    && request.auth.uid
                       in request.resource.data.playerUids
                    && request.resource.data.playerUids.size() == 2
                    && request.resource.data.questionCount
                       in [10, 20, 30];

      allow read: if signedIn()
                  && request.auth.uid
                     in resource.data.playerUids;

      allow update: if signedIn()
                    && request.auth.uid
                       in resource.data.playerUids
                    && request.resource.data.playerUids ==
                       resource.data.playerUids
                    && request.resource.data.questionCount ==
                       resource.data.questionCount;

      allow delete: if false;
    }
  }
}
