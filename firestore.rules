rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function duelProgress(matchId, userId) {
      return get(
        /databases/$(database)/documents/live_duel_matches/$(matchId)/progress/$(userId)
      );
    }

    function validDuelCompletion(matchId) {
      let firstUid = resource.data.playerUids[0];
      let secondUid = resource.data.playerUids[1];
      let firstProgress = duelProgress(matchId, firstUid).data;
      let secondProgress = duelProgress(matchId, secondUid).data;
      let firstScore = request.resource.data.scores[firstUid];
      let secondScore = request.resource.data.scores[secondUid];

      return resource.data.get('resultProcessed', false) != true
             && request.resource.data.resultProcessed == true
             && request.resource.data.resultVersion == 1
             && request.resource.data.status == 'completed'
             && request.resource.data.processedBy == request.auth.uid
             && request.resource.data.completedAt == request.time
             && request.resource.data.updatedAt == request.time
             && request.resource.data.scores is map
             && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'status',
                  'resultProcessed',
                  'resultVersion',
                  'scores',
                  'winnerUid',
                  'draw',
                  'processedBy',
                  'completedAt',
                  'updatedAt'
                ])
             && firstProgress.finished == true
             && secondProgress.finished == true
             && firstProgress.answeredCount ==
                resource.data.questionCount
             && secondProgress.answeredCount ==
                resource.data.questionCount
             && firstProgress.correctCount +
                firstProgress.wrongCount ==
                resource.data.questionCount
             && secondProgress.correctCount +
                secondProgress.wrongCount ==
                resource.data.questionCount
             && firstScore == firstProgress.correctCount
             && secondScore == secondProgress.correctCount
             && (
               (
                 firstScore == secondScore
                 && request.resource.data.draw == true
                 && request.resource.data.winnerUid == null
               )
               ||
               (
                 firstScore > secondScore
                 && request.resource.data.draw == false
                 && request.resource.data.winnerUid == firstUid
               )
               ||
               (
                 secondScore > firstScore
                 && request.resource.data.draw == false
                 && request.resource.data.winnerUid == secondUid
               )
             );
    }

    match /users/{userId} {
      allow read, write: if signedIn()
                         && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
                         && request.auth.uid == userId;
    }

    match /live_duel_queue/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.questionCount
                       in [10, 20, 30];

      allow delete: if signedIn()
                    && request.auth.uid == userId;

      allow update: if signedIn()
                    && (
                      request.auth.uid == userId
                      ||
                      (
                        resource.data.status == 'waiting'
                        && request.resource.data.status == 'matched'
                        && request.resource.data.uid ==
                           resource.data.uid
                        && request.resource.data.rating ==
                           resource.data.rating
                        && request.resource.data.ratingBucket ==
                           resource.data.ratingBucket
                        && request.resource.data.questionCount ==
                           resource.data.questionCount
                        && request.resource.data.matchId is string
                        && request.resource.data.claimedBy ==
                           request.auth.uid
                      )
                    );
    }

    match /live_duel_matches/{matchId} {
      allow create: if signedIn()
                    && request.auth.uid
                       in request.resource.data.playerUids
                    && request.resource.data.playerUids.size() == 2
                    && request.resource.data.questionCount
                       in [10, 20, 30];

      allow read: if signedIn()
                  && request.auth.uid
                     in resource.data.playerUids;

      allow update: if signedIn()
                    && request.auth.uid
                       in resource.data.playerUids
                    && validDuelCompletion(matchId);

      allow delete: if false;

      match /progress/{userId} {
        allow read: if signedIn()
                    && request.auth.uid
                       in get(
                         /databases/$(database)/documents/live_duel_matches/$(matchId)
                       ).data.playerUids;

        allow create, update: if signedIn()
                              && request.auth.uid == userId
                              && request.resource.data.uid == userId
                              && request.resource.data.answeredCount >= 0
                              && request.resource.data.correctCount >= 0
                              && request.resource.data.wrongCount >= 0
                              && request.resource.data.answeredCount ==
                                 request.resource.data.correctCount +
                                 request.resource.data.wrongCount
                              && request.resource.data.currentQuestionIndex ==
                                 request.resource.data.answeredCount
                              && request.resource.data.answeredCount <=
                                 get(
                                   /databases/$(database)/documents/live_duel_matches/$(matchId)
                                 ).data.questionCount
                              && get(
                                   /databases/$(database)/documents/live_duel_matches/$(matchId)
                                 ).data.get('resultProcessed', false) != true;

        allow delete: if false;
      }
    }
  }
}
