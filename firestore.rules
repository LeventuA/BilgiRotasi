rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUsername(username) {
      return username is string
             && username.size() >= 3
             && username.size() <= 16
             && username.matches(
               '^[a-z0-9][a-z0-9_]{2,15}$'
             )
             && !(username in [
               'admin',
               'administrator',
               'moderator',
               'mod',
               'sistem',
               'system',
               'destek',
               'support',
               'bilgirotasi',
               'bilgi_rotasi',
               'google',
               'firebase',
               'null',
               'undefined'
             ]);
    }

    function userUsername(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.username;
    }

    function validUsernameBinding(userId) {
      let username = request.resource.data.username;

      return validUsername(username)
             && request.resource.data.usernameChangedAt ==
                request.time
             && getAfter(
               /databases/$(database)/documents/usernames/$(username)
             ).data.uid == userId
             && getAfter(
               /databases/$(database)/documents/usernames/$(username)
             ).data.username == username;
    }

    function validUserCreate(userId) {
      return !request.resource.data.keys().hasAny([
               'username',
               'usernameChangedAt'
             ])
             || validUsernameBinding(userId);
    }

    function validUserUpdate(userId) {
      let affected = request.resource.data
        .diff(resource.data)
        .affectedKeys();
      let changesUsername = affected.hasAny([
        'username',
        'usernameChangedAt'
      ]);

      return !changesUsername
             || (
               validUsernameBinding(userId)
               && (
                 !resource.data.keys().hasAll([
                   'usernameChangedAt'
                 ])
                 || request.time >=
                    resource.data.usernameChangedAt +
                    duration.value(30, 'd')
               )
             );
    }

    function userDuelProfile(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.liveDuelProfile;
    }

    function validLeaderboardWrite(userId) {
      let profile = userDuelProfile(userId);

      return signedIn()
             && request.auth.uid == userId
             && profile is map
             && request.resource.data.keys().hasOnly([
               'uid',
               'displayName',
               'rating',
               'matchesPlayed',
               'wins',
               'losses',
               'draws',
               'bestWinStreak',
               'highestRating',
               'updatedAt',
               'appVersion'
             ])
             && request.resource.data.uid == userId
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() > 0
             && request.resource.data.displayName.size() <= 16
             && request.resource.data.displayName ==
                userUsername(userId)
             && request.resource.data.rating == profile.rating
             && request.resource.data.matchesPlayed ==
                profile.matchesPlayed
             && request.resource.data.wins == profile.wins
             && request.resource.data.losses == profile.losses
             && request.resource.data.draws == profile.draws
             && request.resource.data.bestWinStreak ==
                profile.bestWinStreak
             && request.resource.data.highestRating ==
                profile.highestRating
             && request.resource.data.updatedAt == request.time
             && request.resource.data.appVersion is string;
    }

    function duelMatch(matchId) {
      return get(
        /databases/$(database)/documents/live_duel_matches/$(matchId)
      );
    }

    function duelProgress(matchId, userId) {
      return get(
        /databases/$(database)/documents/live_duel_matches/$(matchId)/progress/$(userId)
      );
    }

    function duelQuestionKey(questionId) {
      return get(
        /databases/$(database)/documents/live_duel_question_keys/$(questionId)
      );
    }

    function validInitialDuelProgress(matchId, userId) {
      let matchData = duelMatch(matchId).data;
      let next = request.resource.data;

      return request.auth.uid == userId
             && request.auth.uid in matchData.playerUids
             && matchData.get('resultProcessed', false) != true
             && next.keys().hasOnly([
               'uid',
               'currentQuestionIndex',
               'answeredCount',
               'correctCount',
               'wrongCount',
               'finished',
               'lastAnswerCorrect',
               'lastQuestionId',
               'lastSelectedOptionIndex',
               'updatedAt',
               'finishedAt'
             ])
             && next.uid == userId
             && next.currentQuestionIndex == 0
             && next.answeredCount == 0
             && next.correctCount == 0
             && next.wrongCount == 0
             && next.finished == false
             && next.lastAnswerCorrect == null
             && next.lastQuestionId == null
             && next.lastSelectedOptionIndex == null
             && next.updatedAt == request.time
             && next.finishedAt == null;
    }

    function validDuelProgressUpdate(matchId, userId) {
      let matchData = duelMatch(matchId).data;
      let previous = resource.data;
      let next = request.resource.data;
      let expectedQuestionId =
        matchData.questionIds[previous.answeredCount];
      let key = duelQuestionKey(expectedQuestionId).data;
      let answerCorrect =
        next.lastSelectedOptionIndex == key.answerIndex;

      return request.auth.uid == userId
             && request.auth.uid in matchData.playerUids
             && matchData.get('resultProcessed', false) != true
             && previous.finished == false
             && previous.answeredCount < matchData.questionCount
             && next.keys().hasOnly([
               'uid',
               'currentQuestionIndex',
               'answeredCount',
               'correctCount',
               'wrongCount',
               'finished',
               'lastAnswerCorrect',
               'lastQuestionId',
               'lastSelectedOptionIndex',
               'updatedAt',
               'finishedAt'
             ])
             && next.uid == userId
             && next.answeredCount == previous.answeredCount + 1
             && next.currentQuestionIndex == next.answeredCount
             && next.lastQuestionId == expectedQuestionId
             && key.answerIndex is int
             && key.optionCount is int
             && key.optionCount >= 2
             && next.lastSelectedOptionIndex is int
             && next.lastSelectedOptionIndex >= 0
             && next.lastSelectedOptionIndex < key.optionCount
             && next.lastAnswerCorrect == answerCorrect
             && next.correctCount ==
                previous.correctCount +
                (answerCorrect ? 1 : 0)
             && next.wrongCount ==
                previous.wrongCount +
                (answerCorrect ? 0 : 1)
             && next.correctCount + next.wrongCount ==
                next.answeredCount
             && next.finished ==
                (next.answeredCount == matchData.questionCount)
             && next.updatedAt == request.time
             && (
               (
                 next.finished == true
                 && next.finishedAt == request.time
               )
               ||
               (
                 next.finished == false
                 && next.finishedAt == null
               )
             )
             && next.diff(previous).affectedKeys().hasOnly([
               'currentQuestionIndex',
               'answeredCount',
               'correctCount',
               'wrongCount',
               'finished',
               'lastAnswerCorrect',
               'lastQuestionId',
               'lastSelectedOptionIndex',
               'updatedAt',
               'finishedAt'
             ]);
    }

    function duelPresenceExists(matchId, userId) {
      return exists(
        /databases/$(database)/documents/live_duel_matches/$(matchId)/presence/$(userId)
      );
    }

    function duelPresence(matchId, userId) {
      return get(
        /databases/$(database)/documents/live_duel_matches/$(matchId)/presence/$(userId)
      );
    }

    function validDuelCompletion(matchId) {
      let firstUid = resource.data.playerUids[0];
      let secondUid = resource.data.playerUids[1];
      let firstProgress = duelProgress(matchId, firstUid).data;
      let secondProgress = duelProgress(matchId, secondUid).data;
      let firstScore = request.resource.data.scores[firstUid];
      let secondScore = request.resource.data.scores[secondUid];

      return resource.data.get('resultProcessed', false) != true
             && request.resource.data.resultProcessed == true
             && request.resource.data.resultVersion == 2
             && request.resource.data.completionType == 'completed'
             && request.resource.data.forfeitLoserUid == null
             && request.resource.data.status == 'completed'
             && request.resource.data.processedBy == request.auth.uid
             && request.resource.data.completedAt == request.time
             && request.resource.data.updatedAt == request.time
             && request.resource.data.scores is map
             && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'status',
                  'resultProcessed',
                  'resultVersion',
                  'completionType',
                  'forfeitLoserUid',
                  'scores',
                  'winnerUid',
                  'draw',
                  'processedBy',
                  'completedAt',
                  'updatedAt'
                ])
             && firstProgress.finished == true
             && secondProgress.finished == true
             && firstProgress.answeredCount ==
                resource.data.questionCount
             && secondProgress.answeredCount ==
                resource.data.questionCount
             && firstProgress.correctCount +
                firstProgress.wrongCount ==
                resource.data.questionCount
             && secondProgress.correctCount +
                secondProgress.wrongCount ==
                resource.data.questionCount
             && firstScore == firstProgress.correctCount
             && secondScore == secondProgress.correctCount
             && (
               (
                 firstScore == secondScore
                 && request.resource.data.draw == true
                 && request.resource.data.winnerUid == null
               )
               ||
               (
                 firstScore > secondScore
                 && request.resource.data.draw == false
                 && request.resource.data.winnerUid == firstUid
               )
               ||
               (
                 secondScore > firstScore
                 && request.resource.data.draw == false
                 && request.resource.data.winnerUid == secondUid
               )
             );
    }

    function validForfeitPresence(matchId, loserUid) {
      return duelPresenceExists(matchId, loserUid)
             && (
               (
                 duelPresence(matchId, loserUid).data.state == 'left'
                 && duelPresence(matchId, loserUid).data.leaveRequested == true
               )
               ||
               (
                 duelPresence(matchId, loserUid).data.state == 'background'
                 && duelPresence(matchId, loserUid).data.connected == false
                 && duelPresence(matchId, loserUid).data.graceUntil <= request.time
               )
             );
    }

    function validDuelForfeit(matchId) {
      let firstUid = resource.data.playerUids[0];
      let secondUid = resource.data.playerUids[1];
      let loserUid = request.resource.data.forfeitLoserUid;
      let winnerUid = request.resource.data.winnerUid;
      let firstProgress = duelProgress(matchId, firstUid).data;
      let secondProgress = duelProgress(matchId, secondUid).data;

      return resource.data.get('resultProcessed', false) != true
             && request.resource.data.resultProcessed == true
             && request.resource.data.resultVersion == 2
             && request.resource.data.completionType == 'forfeit'
             && loserUid in resource.data.playerUids
             && winnerUid in resource.data.playerUids
             && loserUid != winnerUid
             && (
               (loserUid == firstUid && winnerUid == secondUid)
               ||
               (loserUid == secondUid && winnerUid == firstUid)
             )
             && validForfeitPresence(matchId, loserUid)
             && request.resource.data.draw == false
             && request.resource.data.status == 'completed'
             && request.resource.data.processedBy
                in resource.data.playerUids
             && request.resource.data.completedAt == request.time
             && request.resource.data.updatedAt == request.time
             && request.resource.data.scores is map
             && request.resource.data.scores[firstUid] ==
                firstProgress.correctCount
             && request.resource.data.scores[secondUid] ==
                secondProgress.correctCount
             && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'status',
                  'resultProcessed',
                  'resultVersion',
                  'completionType',
                  'forfeitLoserUid',
                  'scores',
                  'winnerUid',
                  'draw',
                  'processedBy',
                  'completedAt',
                  'updatedAt'
                ]);
    }

    function validPresenceWrite(matchId, userId) {
      let matchData = duelMatch(matchId).data;
      let state = request.resource.data.state;

      return request.auth.uid == userId
             && request.auth.uid in matchData.playerUids
             && matchData.get('resultProcessed', false) != true
             && request.resource.data.uid == userId
             && state in ['active', 'background', 'left']
             && request.resource.data.updatedAt == request.time
             && (
               (
                 state == 'active'
                 && request.resource.data.connected == true
                 && request.resource.data.leaveRequested == false
                 && request.resource.data.disconnectedAt == null
                 && request.resource.data.graceUntil == null
               )
               ||
               (
                 state == 'background'
                 && request.resource.data.connected == false
                 && request.resource.data.leaveRequested == false
                 && request.resource.data.disconnectedAt == request.time
                 && request.resource.data.graceUntil is timestamp
                 && request.resource.data.graceUntil > request.time
                 && request.resource.data.graceUntil <=
                    request.time + duration.value(190, 's')
               )
               ||
               (
                 state == 'left'
                 && request.resource.data.connected == false
                 && request.resource.data.leaveRequested == true
                 && request.resource.data.disconnectedAt == request.time
                 && request.resource.data.graceUntil is timestamp
                 && request.resource.data.graceUntil <= request.time
               )
             );
    }

    match /users/{userId} {
      allow read: if signedIn()
                  && request.auth.uid == userId;

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && validUserCreate(userId);

      allow update: if signedIn()
                    && request.auth.uid == userId
                    && validUserUpdate(userId);

      allow delete: if signedIn()
                    && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && validUsername(username)
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'username',
                      'createdAt'
                    ])
                    && request.resource.data.uid ==
                       request.auth.uid
                    && request.resource.data.username ==
                       username
                    && request.resource.data.createdAt ==
                       request.time
                    && getAfter(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.username == username
                    && getAfter(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.usernameChangedAt == request.time;

      allow update: if false;

      allow delete: if signedIn()
                    && resource.data.uid ==
                       request.auth.uid
                    && (
                      !existsAfter(
                        /databases/$(database)/documents/users/$(request.auth.uid)
                      )
                      || getAfter(
                        /databases/$(database)/documents/users/$(request.auth.uid)
                      ).data.username != username
                    );
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
                         && request.auth.uid == userId;
    }

    match /live_duel_leaderboard/{userId} {
      allow read: if signedIn();

      allow create, update: if validLeaderboardWrite(userId);

      allow delete: if signedIn()
                    && request.auth.uid == userId;
    }

    match /live_duel_queue/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.displayName ==
                       userUsername(userId)
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.questionCount
                       in [10, 20, 30];

      allow delete: if signedIn()
                    && request.auth.uid == userId;

      allow update: if signedIn()
                    && (
                      request.auth.uid == userId
                      ||
                      (
                        resource.data.status == 'waiting'
                        && request.resource.data.status == 'matched'
                        && request.resource.data.uid ==
                           resource.data.uid
                        && request.resource.data.rating ==
                           resource.data.rating
                        && request.resource.data.ratingBucket ==
                           resource.data.ratingBucket
                        && request.resource.data.questionCount ==
                           resource.data.questionCount
                        && request.resource.data.matchId is string
                        && request.resource.data.claimedBy ==
                           request.auth.uid
                      )
                    );
    }

    match /live_duel_question_keys/{questionId} {
      allow read, write: if false;
    }

    match /live_duel_matches/{matchId} {
      allow create: if signedIn()
                    && request.auth.uid
                       in request.resource.data.playerUids
                    && request.resource.data.playerUids.size() == 2
                    && request.resource.data.players.size() == 2
                    && request.resource.data.players[0].uid ==
                       request.resource.data.playerUids[0]
                    && request.resource.data.players[1].uid ==
                       request.resource.data.playerUids[1]
                    && request.resource.data.players[0].displayName ==
                       userUsername(
                         request.resource.data.playerUids[0]
                       )
                    && request.resource.data.players[1].displayName ==
                       userUsername(
                         request.resource.data.playerUids[1]
                       )
                    && request.resource.data.questionCount
                       in [10, 20, 30];

      allow read: if signedIn()
                  && request.auth.uid
                     in resource.data.playerUids;

      allow update: if signedIn()
                    && request.auth.uid
                       in resource.data.playerUids
                    && (
                      validDuelCompletion(matchId)
                      || validDuelForfeit(matchId)
                    );

      allow delete: if false;

      match /progress/{userId} {
        allow read: if signedIn()
                    && request.auth.uid
                       in duelMatch(matchId).data.playerUids;

        allow create: if signedIn()
                      && validInitialDuelProgress(matchId, userId);

        allow update: if signedIn()
                      && validDuelProgressUpdate(matchId, userId);

        allow delete: if false;
      }

      match /presence/{userId} {
        allow read: if signedIn()
                    && request.auth.uid
                       in duelMatch(matchId).data.playerUids;

        allow create, update: if signedIn()
                              && validPresenceWrite(matchId, userId);

        allow delete: if false;
      }
    }
  }
}
