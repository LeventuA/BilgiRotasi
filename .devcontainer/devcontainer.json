{
  "name": "Bilgi Rotasi Flutter",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteEnv": {
    "PATH": "/workspaces/flutter/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/setup_flutter.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/workspaces/flutter",
        "dart.lineLength": 80
      }
    }
  }
}
